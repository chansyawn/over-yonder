{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Over Yonder",
  "version": "0.0.0",
  "identifier": "app.overyonder.desktop",
  "build": {
    "beforeDevCommand": "vp dev",
    "beforeBuildCommand": "vp build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Over Yonder",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
